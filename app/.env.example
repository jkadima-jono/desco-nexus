# DESCO Nexus environment variables.
# Copy to .env and fill in. Never commit .env — it is git-ignored.
#
#   cp .env.example .env
#
# NODE_ENV and VERCEL_ENV are set by the platform. Do not set them here.

# ---------- Required: database ----------
# PostgreSQL. Hosted Postgres (Neon, Supabase, RDS) or a local instance.
# SQLite will NOT work: the schema uses PostgreSQL-specific features, and
# a serverless deployment has no persistent local filesystem.
#
# DATABASE_URL  is the pooled connection used at runtime.
# DIRECT_URL    is the unpooled connection used for migrations
#               (prisma db push / migrate). With Neon these differ; with a
#               plain local Postgres both can be the same value.
DATABASE_URL="postgresql://user:password@host:5432/desco_nexus?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/desco_nexus?sslmode=require"

# ---------- Required: sessions ----------
# Signs the session cookie (HS256 via jose). MUST be at least 32 characters
# in production — the app throws on startup otherwise. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Use a DIFFERENT value per environment. Rotating it signs everyone out.
SESSION_SECRET="generate-a-long-random-value-at-least-32-chars"

# ---------- Required for project image and confidential document uploads ----------
# The store must support private blobs. Project images are public; data-room
# documents are private and are streamed only after server-side authorization.
BLOB_READ_WRITE_TOKEN=""

# ---------- Optional: public site URL ----------
# Absolute base used for canonical links, sitemap and Open Graph metadata.
# Use the dedicated Compass origin. Do not point this at the corporate website.
#
# Production example: https://compass.desco.global
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------- Public environment notice ----------
# Keep true while the workspace uses fictional accounts or demo-only flows.
# The site renders one global notice when true and no global notice when false.
NEXT_PUBLIC_DEMO_MODE="true"

# ---------- Optional: AI assistance ----------
# Used for teaser drafting and message drafts. If unset, those features fall
# back to an offline template and label themselves as such — they do not
# silently pretend a model ran.
ANTHROPIC_API_KEY=""
ANTHROPIC_BASE_URL=""
ANTHROPIC_MODEL=""
AI_REQUEST_TIMEOUT_MS="8000"

# ---------- Feature-gated email accounts ----------
# Keep false until approved account terms/privacy versions exist and a mail
# provider implementation plus verified sending domain are operational.
OPEN_SIGNUP_ENABLED="false"
ACCOUNT_TERMS_VERSION=""
PRIVACY_NOTICE_VERSION=""
EMAIL_PROVIDER="" # supported production value: resend
EMAIL_PROVIDER_API_KEY=""
EMAIL_FROM_ADDRESS=""

# ---------- Explicit demo access ----------
# Optional local/preview demo personas. This flag cannot enable demo access in
# production. The administrator persona is additionally restricted to local
# development and is never available on an internet deployment.
DEMO_AUTH_ENABLED="false"

# Optional email of the administrator who owns new public CRM inquiries.
# If unset, the first administrator is used. Collection fails closed if no
# administrator account exists.
CRM_INTAKE_OWNER_EMAIL=""

# ---------- Scheduled operations ----------
# Vercel Cron sends this value as a Bearer token. Maintenance fails closed
# when it is absent. Generate an independent random value per environment.
CRON_SECRET=""
PRODUCT_EVENT_RETENTION_DAYS="90"
QUARANTINE_EXPIRY_HOURS="72"

# ---------- Confidential document quarantine ----------
# Keep uploads disabled until an approved malware scanner is integrated and
# the provider identifier is configured. These flags do not implement scanning.
CONFIDENTIAL_UPLOADS_ENABLED="false"
DOCUMENT_SCANNER_PROVIDER=""

# ---------- Public contact-form collection ----------
# Production collection fails closed until privacy, retention and form terms
# have been legally approved. Set this only after that review is complete.
ENABLE_PUBLIC_FORM_COLLECTION="false"
