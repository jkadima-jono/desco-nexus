# DESCO Nexus environment variables.
# Copy to .env and fill in. Never commit .env — it is git-ignored.
#
#   cp .env.example .env
#
# NODE_ENV and VERCEL_ENV are set by the platform. Do not set them here.

# ---------- Required: database ----------
# PostgreSQL. Hosted Postgres (Neon, Supabase, RDS) or a local instance.
# SQLite will NOT work: the schema uses PostgreSQL-specific features, and
# a serverless deployment has no persistent local filesystem.
#
# DATABASE_URL  is the pooled connection used at runtime.
# DIRECT_URL    is the unpooled connection used for migrations
#               (prisma db push / migrate). With Neon these differ; with a
#               plain local Postgres both can be the same value.
DATABASE_URL="postgresql://user:password@host:5432/desco_nexus?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/desco_nexus?sslmode=require"

# ---------- Required: sessions ----------
# Signs the session cookie (HS256 via jose). MUST be at least 32 characters
# in production — the app throws on startup otherwise. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Use a DIFFERENT value per environment. Rotating it signs everyone out.
SESSION_SECRET="generate-a-long-random-value-at-least-32-chars"

# ---------- Required for project image and confidential document uploads ----------
# The store must support private blobs. Project images are public; data-room
# documents are private and are streamed only after server-side authorization.
BLOB_READ_WRITE_TOKEN=""

# ---------- Optional: public site URL ----------
# Absolute base used for canonical links, sitemap and Open Graph metadata.
# Use the dedicated Compass origin. Do not point this at the corporate website.
#
# Production example: https://compass.desco.global
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------- Optional: AI assistance ----------
# Used for teaser drafting and message drafts. If unset, those features fall
# back to an offline template and label themselves as such — they do not
# silently pretend a model ran.
ANTHROPIC_API_KEY=""
ANTHROPIC_BASE_URL=""

# ---------- Not yet functional: email sign-in ----------
# The sign-in token core (src/lib/loginToken.ts) is implemented and tested,
# but no provider is wired up: src/lib/mailer.ts fails closed until
# sendViaProvider() is implemented against a chosen provider.
# Setting these alone will NOT enable email sign-in.
# Requires, in addition: a provider account (Resend/Postmark/SES) and a
# sending domain verified by SPF/DKIM DNS records.
EMAIL_PROVIDER_API_KEY=""
EMAIL_FROM_ADDRESS=""

# ---------- Explicit demo access ----------
# Enables the four fictional persona workspaces. Production stays closed unless
# this exact flag is set to true in the Production environment.
DEMO_AUTH_ENABLED="true"
