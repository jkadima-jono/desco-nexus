{
  "name": "desco-nexus",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit --incremental false",
    "test:api": "node --test tests/api.test.mjs",
    "test:unit": "tsx --test tests/loginToken.test.ts",
    "test": "npm run typecheck && npm run test:unit",
    "check": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@vercel/blob": "^2.6.1",
    "jose": "^6.2.3",
    "next": "^15.3.0",
    "prisma": "^6.19.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.23.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.6.0"
  },
  "overrides": {
    "sharp": "^0.35.3",
    "postcss": "^8.5.24"
  },
  "allowScripts": {
    "@prisma/client@7.8.0": true,
    "prisma@7.8.0": true
  }
}
